        "jsCode": "const row = items[0].json;\nconst plot = row.plot_number || row['Участок'] || row['участок'] || row['plot'] || '';\nif (plot) {\n  return [{ json: { registered: true, plot_number: String(plot) } }];\n} else {\n  return [{ json: { registered: false } }];\n}"
      },
