      "parameters": {
        "jsCode": "const b = items[0].json.body || items[0].json;\nconst user_id = String(b.user_id || b.userId || b.telegram_id || '');\nconst plot    = String(b.plot || b.plot_number || '').trim();\nconst surname = String(b.surname || b.last_name || '').trim();\nconst phone   = String(b.phone || b.phone_number || '').trim().replace(/\\s+/g, '');\nreturn [{ json: { user_id, plot, surname, phone } }];"
      },
