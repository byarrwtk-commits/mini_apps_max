    {
      "parameters": {
        "jsCode": "const regRow = items[0].json;\nconst input  = $('Prep Register').first().json;\n\n// Проверяем что участок найден\nconst foundPlot = regRow['Участок'] || regRow['участок'] || regRow['plot'] || '';\nif (!foundPlot) {\n  return [{ json: { success: false, not_found: true } }];\n}\n\n// Проверяем фамилию (нечёткое совпадение — без учёта регистра)\nconst foundSurname = String(regRow['Фамилия'] || regRow['фамилия'] || regRow['ФИО'] || regRow['fio'] || '').toLowerCase();\nconst inputSurname = input.surname.toLowerCase();\nif (!foundSurname.includes(inputSurname)) {\n  return [{ json: { success: false, not_found: true } }];\n}\n\n// Всё ок — готовим данные для записи\nreturn [{ json: {\n  ok: true,\n  plot: String(foundPlot),\n  user_id: input.user_id,\n  surname: input.surname,\n  phone: input.phone\n} }];"
      },
