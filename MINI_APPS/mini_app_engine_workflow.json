      "parameters": {
        "jsCode": "const news = items.map(item => ({\n  title: item.json.title || '',\n  date: item.json.pubDate || item.json.isoDate || '',\n  description: (item.json.contentSnippet || item.json.summary || item.json.description || '').substring(0, 300),\n  link: item.json.link || ''\n}));\nreturn [{ json: { news } }];"
      },
