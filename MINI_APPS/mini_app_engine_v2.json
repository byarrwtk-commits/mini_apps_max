      "typeVersion": 2,
      "position": [
        720,
        460
      ],
      "parameters": {
        "jsCode": "const b = items[0].json.body || items[0].json;\nreturn [{ json: {\n  user_id: String(b.user_id || b.userId || \"\"),\n  plot:    String(b.plot || b.plot_number || \"\").trim(),\n  surname: String(b.surname || b.last_name || \"\").trim(),\n  phone:   String(b.phone || b.phone_number || \"\").trim().replace(/\\s+/g, \"\")\n} }];"
      }
