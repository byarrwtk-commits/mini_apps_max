    {
      "id": "95ca21b9-afda-4b0e-8bc1-ff1b1f8acc30",
      "name": "Format News",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        60
      ],
      "parameters": {
        "jsCode": "const news = items.map(i => ({\n  title: i.json.title || \"\",\n  date: i.json.pubDate || i.json.isoDate || \"\",\n  description: String(i.json.contentSnippet || i.json.summary || i.json.description || \"\").substring(0, 300),\n  link: i.json.link || \"\"\n}));\nreturn [{ json: { news } }];"
      }
    },
    {
      "id": "907cb3a1-e64d-42e7-a9a6-3eb2f8d27d10",
      "name": "Respond News",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1200,
        60
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify($json.news) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      }
    },
