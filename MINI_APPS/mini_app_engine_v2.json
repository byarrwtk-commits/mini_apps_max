    {
      "id": "897408cb-93eb-4d9b-b0a4-96d243bf0b37",
      "name": "Verify Registration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        460
      ],
      "parameters": {
        "jsCode": "const regRow   = items[0].json;\nconst input    = $node[\"Prep Register\"].json;\n\nconst foundPlot = regRow[\"Участок\"] || regRow[\"участок\"] || regRow.plot || \"\";\nif (!foundPlot) return [{ json: { success: false, not_found: true } }];\n\nconst foundSurname = String(regRow[\"Фамилия\"] || regRow[\"фамилия\"] || regRow[\"ФИО\"] || \"\").toLowerCase();\nconst inputSurname = input.surname.toLowerCase();\nif (foundSurname && !foundSurname.includes(inputSurname)) {\n  return [{ json: { success: false, not_found: true } }];\n}\n\nreturn [{ json: { ok: true, plot: String(foundPlot), user_id: input.user_id, surname: input.surname, phone: input.phone } }];"
      }
