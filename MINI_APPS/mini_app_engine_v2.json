      "parameters": {
        "jsCode": "const debtRow = items[0].json;\nconst regRow  = $node[\"Lookup Cabinet User\"].json;\nconst plot    = regRow.plot_number || regRow[\"plot_number\"] || regRow[\"Участок\"] || \"\";\nconst balance = debtRow[\"Задолженность\"] || debtRow[\"Долг\"] || debtRow.balance || \"0\";\nif (!plot) return [{ json: { registered: false } }];\nreturn [{ json: { registered: true, plot_number: String(plot), balance: String(balance) } }];"
