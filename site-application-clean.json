{
  "name": "Agent - Обработка заявок с сайта",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "site-application",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - Новая заявка",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.body.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            },
            {
              "id": "condition-2",
              "leftValue": "={{ $json.body.name }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "validate-data",
      "name": "Валидация заявки",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "application_id",
              "value": "={{ $json.body.application_id || 'APP-' + $now.format('YYYYMMDD-HHmmss') }}"
            },
            {
              "name": "name",
              "value": "={{ $json.body.name }}"
            },
            {
              "name": "email",
              "value": "={{ $json.body.email }}"
            },
            {
              "name": "phone",
              "value": "={{ $json.body.phone || '' }}"
            },
            {
              "name": "message",
              "value": "={{ $json.body.message || '' }}"
            },
            {
              "name": "source",
              "value": "={{ $json.body.source || 'website' }}"
            },
            {
              "name": "status",
              "value": "new"
            },
            {
              "name": "created_at",
              "value": "={{ $now }}"
            },
            {
              "name": "priority",
              "value": "normal"
            }
          ]
        },
        "options": {}
      },
      "id": "normalize-data",
      "name": "Нормализация данных",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Классификация приоритета на основе содержимого\nconst data = $input.all()[0].json;\nconst message = (data.message || '').toLowerCase();\nconst email = (data.email || '').toLowerCase();\n\nlet priority = 'normal';\nlet tags = [];\n\n// Определение приоритета\nif (message.includes('срочно') || message.includes('urgent') || message.includes('срочный')) {\n  priority = 'high';\n  tags.push('urgent');\n} else if (message.includes('вопрос') || message.includes('question')) {\n  priority = 'low';\n  tags.push('question');\n} else if (message.includes('заказ') || message.includes('покупка') || message.includes('buy')) {\n  priority = 'high';\n  tags.push('sales');\n}\n\n// Проверка на бизнес-эмейлы\nif (email.includes('@company') || email.includes('.org') || email.includes('.edu')) {\n  priority = priority === 'normal' ? 'medium' : priority;\n  tags.push('business');\n}\n\nreturn [{\n  json: {\n    ...data,\n    priority,\n    tags,\n    classified_at: $now\n  }\n}];"
      },
      "id": "classify-priority",
      "name": "Классификация приоритета",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "applications",
        "columns": "application_id, name, email, phone, message, source, status, priority, tags, created_at, classified_at",
        "additionalFields": {
          "query": "INSERT INTO applications (application_id, name, email, phone, message, source, status, priority, tags, created_at, classified_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
        }
      },
      "id": "save-to-database",
      "name": "Сохранить в БД",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1120,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-credentials",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "channel": "#applications",
        "text": "🆕 Новая заявка с сайта\n\n📧 Email: {{ $json.email }}\n👤 Имя: {{ $json.name }}\n📞 Телефон: {{ $json.phone }}\n📝 Сообщение: {{ $json.message }}\n🎯 Приоритет: {{ $json.priority }}\n🏷️ Теги: {{ $json.tags.join(', ') }}\n\nID: {{ $json.application_id }}",
        "otherOptions": {
          "includeLinkToWorkflow": true
        }
      },
      "id": "slack-notify",
      "name": "Уведомить в Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        1340,
        200
      ],
      "credentials": {
        "slackApi": {
          "id": "slack-credentials",
          "name": "Slack"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "noreply@company.com",
        "toEmail": "{{ $json.email }}",
        "subject": "Ваша заявка принята #{{ $json.application_id }}",
        "text": "Здравствуйте, {{ $json.name }}!\n\nМы получили вашу заявку и обязательно свяжемся с вами в ближайшее время.\n\nНомер вашей заявки: {{ $json.application_id }}\n\nС уважением,\nКоманда компании",
        "options": {}
      },
      "id": "email-confirm",
      "name": "Отправить подтверждение",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1340,
        320
      ],
      "credentials": {
        "smtp": {
          "id": "smtp-credentials",
          "name": "SMTP"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"status\": \"success\", \"message\": \"Заявка успешно принята\", \"application_id\": \"{{ $json.application_id }}\" }"
      },
      "id": "webhook-response",
      "name": "Ответ вебхуку",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1560,
        260
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"status\": \"error\", \"message\": \"Отсутствуют обязательные поля: email, name\" }",
        "options": {
          "responseCode": 400
        }
      },
      "id": "error-response",
      "name": "Ответ об ошибке",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        680,
        400
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "application-error",
        "options": {}
      },
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        240,
        500
      ]
    },
    {
      "parameters": {
        "channel": "#errors",
        "text": "🚨 Ошибка в обработке заявки\n\nОшибка: {{ $json.errorMessage }}\nРабочий процесс: {{ $json.workflowId }}\nВремя: {{ $now }}\n\nДанные: {{ $json.inputData }}"
      },
      "id": "error-slack",
      "name": "Уведомить об ошибке",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        460,
        500
      ]
    }
  ],
