# URL вашего n8n инстанса
N8N_URL=https://your-n8n-instance.com

# API-ключ n8n (Settings → API → Create API Key)
N8N_API_KEY=your_jwt_token_here

# MCP-сервер
MCP_SERVER_PORT=3001
MCP_SERVER_NAME=n8n-mcp-client

# Google Sheets (для generate_wf.js)
GOOGLE_CRED_ID=your_google_credential_id
SHEET_ID=your_google_sheet_id
RSS_URL=https://your-site.ru/feed/
